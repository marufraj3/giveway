# Optional; defaults to v26.0. Use a currently supported Graph API version.
META_GRAPH_API_VERSION=v26.0

# Optional. Meta app secret (Meta app dashboard -> Settings -> Basic -> App secret).
# When set, every Graph request carries a derived appsecret_proof, which apps with
# "Require App Secret" enabled need. It never reaches the browser and is never stored.
META_APP_SECRET=
